{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Stores user gamification data.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "xp": { "type": "number" },
        "level": { "type": "number" },
        "streak": { "type": "number" },
        "lastActive": { "type": "string", "format": "date-time" },
        "achievements": { "type": "array", "items": { "type": "string" } },
        "customCompanies": { "type": "array", "items": { "type": "string" } },
        "dailyGoal": { "type": "number" }
      },
      "required": ["uid", "xp", "level", "streak", "lastActive", "achievements"]
    },
    "QuizSession": {
      "title": "QuizSession",
      "description": "Stores the history of a user's quiz session.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The ID of the user who took the quiz."
        },
        "score": {
          "type": "number",
          "description": "The final score percentage."
        },
        "correctAnswers": {
          "type": "number",
          "description": "The number of correct answers."
        },
        "totalQuestions": {
          "type": "number",
          "description": "The total number of questions."
        },
        "timeTaken": {
          "type": "number",
          "description": "The time taken in seconds."
        },
        "categoriesAttempted": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "List of categories attempted in the quiz."
        },
        "company": {
          "type": "string",
          "description": "Target company or category name."
        },
        "questions": {
          "type": "string",
          "description": "JSON stringified array of questions"
        },
        "answers": {
          "type": "string",
          "description": "JSON stringified record of answers"
        },
        "isPracticeMode": {
          "type": "boolean",
          "description": "Whether the session was taken in practice mode"
        },
        "isMockAssessment": {
          "type": "boolean",
          "description": "Whether the session was a full mock assessment"
        },
        "isAdaptive": {
          "type": "boolean",
          "description": "Whether the session used adaptive difficulty"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "The timestamp when the quiz was completed."
        }
      },
      "required": ["userId", "score", "correctAnswers", "totalQuestions", "timeTaken", "categoriesAttempted", "createdAt"]
    },
    "QuestionPool": {
      "title": "QuestionPool",
      "description": "Stores the extracted question pool for a user.",
      "type": "object",
      "properties": {
        "pool": {
          "type": "string",
          "description": "JSON stringified array of questions in the pool."
        },
        "progress": {
          "type": "string",
          "description": "JSON stringified record of questionId -> QuestionProgress"
        },
        "activeSession": {
          "type": "string",
          "description": "JSON stringified active session state"
        }
      },
      "required": ["pool"]
    },
    "StudyGuide": {
      "title": "StudyGuide",
      "description": "Stores generated study guides for users.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The user ID who owns the study guide."
        },
        "title": {
          "type": "string",
          "description": "Title of the study guide."
        },
        "category": {
          "type": "string",
          "description": "Assessment category."
        },
        "content": {
          "type": "string",
          "description": "Markdown content of the study guide."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when created."
        }
      },
      "required": ["userId", "title", "category", "content", "createdAt"]
    }
  },
  "firestore": {
    "/quizSessions/{sessionId}": {
      "schema": {
        "$ref": "#/entities/QuizSession"
      },
      "description": "Collection of quiz sessions."
    },
    "/questionPools/{userId}": {
      "schema": {
        "$ref": "#/entities/QuestionPool"
      },
      "description": "Collection of question pools, keyed by user ID."
    },
    "/profiles/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "User profile data including XP, level, and streak."
    },
    "/studyGuides/{guideId}": {
      "schema": {
        "$ref": "#/entities/StudyGuide"
      },
      "description": "Collection of study guides."
    }
  }
}
