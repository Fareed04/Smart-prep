rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function isValidQuizSession(data) {
      return hasOnlyAllowedFields(['userId', 'score', 'correctAnswers', 'totalQuestions', 'timeTaken', 'categoriesAttempted', 'questions', 'answers', 'createdAt', 'company', 'isPracticeMode', 'isMockAssessment', 'isAdaptive']) &&
             data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             data.score is number && data.score >= 0 && data.score <= 100 &&
             data.correctAnswers is number && data.correctAnswers >= 0 &&
             data.totalQuestions is number && data.totalQuestions > 0 &&
             data.timeTaken is number && data.timeTaken >= 0 &&
             data.categoriesAttempted is list && data.categoriesAttempted.size() <= 100 &&
             (!('questions' in data) || data.questions is string) &&
             (!('answers' in data) || data.answers is string) &&
             (!('company' in data) || (data.company is string && data.company.size() <= 100)) &&
             (!('isPracticeMode' in data) || data.isPracticeMode is bool) &&
             (!('isMockAssessment' in data) || data.isMockAssessment is bool) &&
             (!('isAdaptive' in data) || data.isAdaptive is bool) &&
             data.createdAt is timestamp;
    }

    function isValidQuestionPool(data) {
      return hasOnlyAllowedFields(['pool', 'progress', 'activeSession']) &&
             data.pool is string &&
             (!('progress' in data) || data.progress is string) &&
             (!('activeSession' in data) || data.activeSession is string);
    }

    function isValidProfile(data) {
      return hasOnlyAllowedFields(['uid', 'xp', 'level', 'streak', 'lastActive', 'achievements', 'dailyGoal', 'customCompanies']) &&
             data.uid is string && data.uid == request.auth.uid &&
             data.xp is number && data.xp >= 0 &&
             data.level is number && data.level >= 1 &&
             data.streak is number && data.streak >= 0 &&
             data.lastActive is string && data.lastActive.size() <= 64 &&
             data.achievements is list && data.achievements.size() <= 100 &&
             (!('dailyGoal' in data) || (data.dailyGoal is number && data.dailyGoal >= 1 && data.dailyGoal <= 1000)) &&
             (!('customCompanies' in data) || (data.customCompanies is list && data.customCompanies.size() <= 100));
    }

    function isValidStudyGuide(data) {
      return hasOnlyAllowedFields(['userId', 'title', 'category', 'content', 'createdAt']) &&
             data.userId is string && data.userId == request.auth.uid &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.category is string && data.category.size() <= 100 &&
             data.content is string &&
             data.createdAt is timestamp;
    }

    // ===============================================================
    // Rules
    // ===============================================================
    match /profiles/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && (request.method == 'delete' || isValidProfile(request.resource.data));
    }

    match /studyGuides/{guideId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && isValidStudyGuide(request.resource.data);
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow update: if false; // Study guides are immutable
    }

    match /quizSessions/{sessionId} {
      // Users can only read their own quiz sessions
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      
      // Users can only create quiz sessions for themselves
      allow create: if isAuthenticated() && 
                    isValidQuizSession(request.resource.data) && 
                    request.resource.data.userId == request.auth.uid;
      
      // Quiz sessions are immutable once created
      allow update, delete: if false;
    }

    match /questionPools/{userId} {
      // Users can only read/write their own question pools
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && 
                     (request.method == 'delete' || isValidQuestionPool(request.resource.data));
    }
  }
}
